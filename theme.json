{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "1380px",
			"wideSize": "1380px"
		},
		"custom": {
			"color": {
				"danger": "#A51A13",
				"gray": {
					"50": "#F5F7F9",
					"100": "#EAEDF1",
					"200": "#D0D5DA",
					"300": "#B0B5BB",
					"400": "#8D939A",
					"500": "#6E737A",
					"600": "#53575D",
					"700": "#3A3D42",
					"800": "#24272A"
				}
			},
			"lineHeight": {
				"small": "1.2",
				"medium": "1.4",
				"normal": "1.6",
				"large": "2",
				"x-large": "2.25",
				"xx-large": "2.5"
			}
		},
		"useRootPaddingAwareAlignments": true,
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#DB261D",
					"name": "Primary"
				},
				{
					"slug": "primary-dark",
					"color": "#A51A13",
					"name": "Primary Dark"
				},
				{
					"slug": "primary-light",
					"color": "#FBE9E8",
					"name": "Primary Light"
				},
				{
					"slug": "secondary",
					"color": "#67696F",
					"name": "Secondary"
				},
				{
					"slug": "foreground",
					"color": "#111111",
					"name": "Foreground"
				},
				{
					"slug": "background",
					"color": "var( --wp--custom--color--gray--50 )",
					"name": "Background"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "gray",
					"color": "var(--wp--custom--color--gray--400)",
					"name": "Gray"
				},
				{
					"slug": "gray-light",
					"color": "var(--wp--custom--color--gray--200)",
					"name": "Gray Light"
				},
				{
					"slug": "gray-dark",
					"color": "var(--wp--custom--color--gray--700)",
					"name": "Gray Dark"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"fontFamily": "'Archivo', sans-serif",
					"name": "Body",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./build/fonts/Archivo/Archivo-VariableFont_wdth,wght.ttf"
							]
						},
						{
							"fontFamily": "Archivo",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./build/fonts/Archivo/Archivo-Italic-VariableFont_wdth,wght.ttf"
							]
						}
					]
				},
				{
					"slug": "heading",
					"fontFamily": "'Archivo', sans-serif",
					"name": "Heading"
				},
				{
					"slug": "monospace",
					"fontFamily": "'Space Mono', monospace",
					"name": "Monospace",
					"fontFace": [
						{
							"fontFamily": "Space Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./build/fonts/Space_Mono/SpaceMono-Regular.ttf"
							]
						},
						{
							"fontFamily": "Space Mono",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./build/fonts/Space_Mono/SpaceMono-Italic.ttf"
							]
						},
						{
							"fontFamily": "Space Mono",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./build/fonts/Space_Mono/SpaceMono-Bold.ttf"
							]
						},
						{
							"fontFamily": "Space Mono",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./build/fonts/Space_Mono/SpaceMono-BoldItalic.ttf"
							]
						}
					]
				}
			],
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.8rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "0.9rem",
					"name": "Medium"
				},
				{
					"slug": "normal",
					"size": "1rem",
					"name": "Normal"
				},
				{
					"slug": "larger",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					},
					"name": "Larger"
				},
				{
					"slug": "large",
					"size": "1.75rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "3.375rem",
					"name": "X-Large"
				},
				{
					"slug": "xx-large",
					"size": "4rem",
					"name": "XX-Large"
				},
				{
					"slug": "xxx-large",
					"size": "8.25rem",
					"fluid": {
						"min": "2.75rem",
						"max": "8.25rem"
					},
					"name": "XXX-Large"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/heading": {
				"variations": {
					"embellished": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--monospace)",
							"textTransform": "uppercase",
							"letterSpacing": "0.14em",
							"fontWeight": "700",
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					},
					"bulleted": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--monospace)",
							"textTransform": "uppercase",
							"letterSpacing": "0.14em",
							"fontWeight": "700",
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					},
					"ruled": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--monospace)",
							"textTransform": "uppercase",
							"letterSpacing": "0.14em",
							"fontWeight": "700",
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					},
					"ruled-left": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--monospace)",
							"textTransform": "uppercase",
							"letterSpacing": "0.14em",
							"fontWeight": "700",
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"textTransform": "uppercase",
					"letterSpacing": " -0.01em",
					"fontWeight": "900",
					"fontSize": "var(--wp--preset--font-size--larger)"
				}
			},
			"core/paragraph": {
				"variations": {
					"intro": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--body)",
							"fontSize": "var(--wp--preset--font-size--larger)",
							"fontWeight": "500",
							"lineHeight": "1.5"
						},
						"color": {
							"text": "var( --wp--custom--color--gray--600 )"
						},
						"css": "max-width: 60ch;"
					},
					"label": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--monospace)",
							"textTransform": "uppercase",
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					},
					"embellished": {
						"typography": {
							"fontFamily": "var(--wp--preset--font-family--monospace)",
							"textTransform": "uppercase",
							"letterSpacing": "0.14em",
							"fontWeight": "700",
							"fontSize": "var(--wp--preset--font-size--small)"
						}
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--foreground)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "0",
					"color": "var(--wp--preset--color--primary)",
					"width": "1px",
					"style": "solid"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--normal)",
					"fontWeight": "600",
					"letterSpacing": "0.05em",
					"textTransform": "uppercase"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "2rem",
						"right": "2rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--white )"
					},
					"border": {
						"color": "var(--wp--preset--color--primary-dark)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--white )"
					},
					"border": {
						"color": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)"
				}
			}
		},
		"spacing": {
			"padding": {
				"left": "1.5rem",
				"right": "1.5rem"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"letterSpacing": "-0.1px",
			"lineHeight": "var(--wp--custom--line-height--normal)"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}